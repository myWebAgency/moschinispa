<% locals.activeNav = 'visione' %>
<div class="page-header">
  <h1 class="page-title">Sezione Visione</h1>
  <p class="page-sub">La presentazione della holding: label, titolo e testo descrittivo.</p>
</div>

<form method="POST" action="/admin/sezione/visione">
  <div class="admin-card">
    <h3>Contenuto</h3>

    <div class="form-group">
      <label class="form-label">Label</label>
      <input type="text" name="label" class="form-input" value="<%= data.label || '' %>">
      <p class="form-hint">Testo dorato sopra il titolo (es. "La Holding")</p>
    </div>

    <div class="form-group">
      <label class="form-label">Titolo</label>
      <input type="text" name="title" class="form-input" value="<%= data.title || '' %>">
    </div>

    <div data-richtext>
      <label class="form-label">Testo</label>
      <textarea name="body" style="display:none;"><%= data.body || '' %></textarea>
    </div>
  </div>

  <div class="btn-row">
    <button type="submit" class="btn-primary">Salva sezione Visione</button>
    <a href="/admin" class="btn-ghost">Annulla</a>
  </div>
</form>
