<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — Moschini S.p.A.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
</head>
<body>
  <!-- Mobile top bar -->
  <div class="mobile-topbar">
    <button class="mobile-hamburger" onclick="toggleSidebar()" aria-label="Apri menu">
      <span></span><span></span><span></span>
    </button>
    <span class="sb-logo" style="font-size:1.1rem;">Moschini</span>
  </div>
  <div class="mobile-overlay" id="mobileOverlay" onclick="toggleSidebar()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sb-header">
      <a href="/admin" class="sb-logo-link">
        <span class="sb-logo">Moschini</span>
        <span class="sb-badge">Pannello di controllo</span>
      </a>
      <button class="sb-close" onclick="toggleSidebar()" aria-label="Chiudi menu">&times;</button>
    </div>

    <nav class="sb-nav">
      <a href="/admin" class="sb-link<%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Dashboard
      </a>

      <% if (can('contents:view')) { %>
      <div class="sb-section-label">Contenuti</div>
      <a href="/admin/sezione/hero" class="sb-link sb-sub<%= typeof activeNav !== 'undefined' && activeNav === 'hero' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Hero
      </a>
      <a href="/admin/sezione/visione" class="sb-link sb-sub<%= typeof activeNav !== 'undefined' && activeNav === 'visione' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Visione
      </a>
      <a href="/admin/sezione/fondatore" class="sb-link sb-sub<%= typeof activeNav !== 'undefined' && activeNav === 'fondatore' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Fondatore
      </a>
      <a href="/admin/sezione/citazioni" class="sb-link sb-sub<%= typeof activeNav !== 'undefined' && activeNav === 'citazioni' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Citazioni
      </a>
      <% } %>

      <% if (can('projects:view')) { %>
      <a href="/admin/projects" class="sb-link sb-sub<%= typeof activeNav !== 'undefined' && activeNav === 'projects' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Progetti / Iniziative
      </a>
      <% } %>

      <% if (can('menu:view')) { %>
      <div class="sb-section-label">Struttura</div>
      <a href="/admin/menu" class="sb-link<%= typeof activeNav !== 'undefined' && activeNav === 'menu' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        Menu
      </a>
      <% } %>

      <% if (can('footer:view')) { %>
      <a href="/admin/footer" class="sb-link<%= typeof activeNav !== 'undefined' && activeNav === 'footer-edit' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="15" x2="21" y2="15"/></svg>
        Footer
      </a>
      <% } %>

      <% if (can('media:view')) { %>
      <div class="sb-section-label">Media</div>
      <a href="/admin/media" class="sb-link<%= typeof activeNav !== 'undefined' && activeNav === 'media' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        Libreria Media
      </a>
      <% } %>

      <% if (can('seo:view')) { %>
      <div class="sb-section-label">Impostazioni</div>
      <a href="/admin/seo" class="sb-link<%= typeof activeNav !== 'undefined' && activeNav === 'seo' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        SEO, Analytics & Search Console
      </a>
      <% } %>

      <% if (can('users:view')) { %>
      <a href="/admin/users" class="sb-link<%= typeof activeNav !== 'undefined' && activeNav === 'users' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Utenti & Permessi
      </a>
      <% } %>
    </nav>

    <div class="sb-footer">
      <div class="sb-user-info">
        <span class="sb-user-name"><%= user ? user.fullName : '' %></span>
        <span class="sb-user-role"><%= user ? user.role.replace(/_/g, ' ') : '' %></span>
      </div>
      <div class="sb-footer-links">
        <a href="/" target="_blank" class="sb-site">Vedi sito &rarr;</a>
        <a href="/admin/logout" class="sb-logout">Esci</a>
      </div>
    </div>
  </aside>

  <main class="admin-main">
    <% if (flash.success && flash.success.length) { %>
      <div class="alert alert-success"><span class="alert-icon">&#10003;</span> <%= flash.success[0] %></div>
    <% } %>
    <% if (flash.error && flash.error.length) { %>
      <div class="alert alert-error"><span class="alert-icon">!</span> <%= flash.error[0] %></div>
    <% } %>
    <%- body %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
